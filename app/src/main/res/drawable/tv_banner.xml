<?xml version="1.0" encoding="utf-8"?>
<!-- Баннер для лаунчера Android TV: 320x180dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E1116" />
        </shape>
    </item>
    <item android:left="24dp" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:width="16dp" android:height="90dp" />
            <solid android:color="#4FC3F7" />
        </shape>
    </item>
</layer-list>
